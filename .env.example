# Sitzungsschlüssel — mit `openssl rand -base64 48` erzeugen.
# Wird der Wert geändert, müssen sich alle Geräte neu anmelden.
SESSION_SECRET=hier-einen-langen-zufallswert-einsetzen

# ── Datenbank: genau eine der beiden Varianten ───────────────────────────────

# Variante A — lokale Datei (Entwicklung, Docker, eigener Server).
# Im Container auf ein Volume zeigen lassen, sonst ist die Datenbank nach
# jedem Update weg.
DATABASE_PATH=./data/finance.db

# Variante B — Turso (Vercel und andere Umgebungen ohne bleibendes
# Dateisystem). Ist TURSO_DATABASE_URL gesetzt, hat sie Vorrang.
# TURSO_DATABASE_URL=libsql://finanzen-deinname.turso.io
# TURSO_AUTH_TOKEN=

# Nur für die Ersteinrichtung im Produktivbetrieb. Solange kein Passwort
# gesetzt ist, verlangt die Anmeldemaske zusätzlich diesen Wert — sonst
# könnte ein Fremder dem frisch veröffentlichten Dienst zuvorkommen.
# Nach dem Setzen des Passworts kann die Variable entfernt werden.
# SETUP_TOKEN=
